{
  "name": "livr",
  "version": "2.13.1",
  "description": "Lightweight validator supporting Language Independent Validation Rules Specification (LIVR 2.0 and LIVR 2.5)",
  "homepage": "https://js.livr-spec.org",
  "author": {
    "name": "koorchik",
    "url": "https://github.com/koorchik"
  },
  "license": "MIT",
  "main": "./lib/LIVR.js",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "async.js",
    "async.d.ts",
    "types",
    "docs/guide",
    "docs/api.md",
    "docs/rules.md",
    "docs/TYPESCRIPT.md",
    "/CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/LIVR.js",
      "import": "./lib/LIVR.js"
    },
    "./async": {
      "types": "./types/async.d.ts",
      "require": "./async.js",
      "import": "./async.js"
    },
    "./async.js": {
      "types": "./types/async.d.ts",
      "require": "./async.js",
      "import": "./async.js"
    },
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./types/inference": {
      "types": "./types/inference.d.ts"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:types",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"t/tests-sync/*.js\" \"t/tests-async/*.js\"",
    "test:types": "tsc --noEmit && tsc --noEmit -p t/tests-types/packages && tsc --noEmit -p t/tests-types/strict && tsc --noEmit -p t/tests-types/strict-args && tsc --noEmit -p t/tests-types/strict-off && tsc --noEmit -p t/tests-types/types-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koorchik/js-validator-livr.git"
  },
  "bugs": {
    "url": "https://github.com/koorchik/js-validator-livr/issues"
  },
  "keywords": [
    "validator",
    "validation",
    "livr",
    "schema",
    "sanitize"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
